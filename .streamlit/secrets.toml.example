# .streamlit/secrets.toml.example
# ==============================================================================
# In Streamlit Community Cloud (share.streamlit.io), you can paste these keys
# under App Settings -> Secrets. None of these are required to start the app,
# but they provide seamless zero-typing cloud authentication if you use them!
# ==============================================================================

# 1. Planet API Key (Optional)
# Automatically pre-fills your Planet API key in the Stage Imagery tab
PLANET_API_KEY = "your_planet_api_key_here"

# 2. Google Earth Engine Project ID (Optional)
# Automatically pre-fills your personal GEE Project ID in the left sidebar
EARTHENGINE_PROJECT = "ee-yourusername"

# 3. Google Earth Engine Authentication for Cloud (Choose Option A or B):

# OPTION A (Easiest - 1 minute): Use your existing local token from your computer:
# Run this on your PC in PowerShell: Get-Content "$env:USERPROFILE\.config\earthengine\credentials" -Raw
# Then paste that exact JSON string here:
# EARTHENGINE_TOKEN = '{"redirect_uri": "...", "refresh_token": "...", "scopes": ["..."]}'

# OPTION B: Google Cloud Service Account (For enterprise/production):
# EARTHENGINE_SERVICE_ACCOUNT = "your-service-account@your-gcp-project.iam.gserviceaccount.com"
# EARTHENGINE_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...\n-----END PRIVATE KEY-----\n"
